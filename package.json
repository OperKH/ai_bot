{
  "name": "ai_bot",
  "version": "1.3.2",
  "private": true,
  "main": "src/app.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/app.ts",
    "dev": "tsx watch src/app.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "build": "tsc && tsc-alias",
    "build:release": "npm run clean && tsc -p tsconfig.release.json && tsc-alias -p tsconfig.release.json",
    "tg:session": "tsc && tsc-alias && node dist/scripts/stringSession.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@iamtraction/google-translate": "^3.0.0",
    "@langfuse/openai": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "dotenv": "^17.4.2",
    "fluent-ffmpeg": "^2.1.3",
    "input": "^1.0.1",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "typeorm": "^1.1.0",
    "wavefile": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=26.7.0",
    "npm": ">=11.19.0"
  }
}
