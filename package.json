{
  "name": "ai_bot",
  "version": "1.3.2",
  "private": true,
  "main": "src/app.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/app.ts",
    "dev": "tsx watch src/app.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "build": "tsc && tsc-alias",
    "build:release": "npm run clean && tsc -p tsconfig.release.json && tsc-alias -p tsconfig.release.json",
    "tg:session": "tsc && tsc-alias && node dist/scripts/stringSession.js",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/files": "^1.2.0",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@huggingface/transformers": "^4.3.1",
    "@iamtraction/google-translate": "^3.0.0",
    "@langfuse/openai": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@rgrove/parse-xml": "^5.0.0",
    "dotenv": "^18.0.7",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "~1.46.0",
    "input": "^1.0.1",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "telegram": "^2.26.22",
    "typeorm": "^1.1.2",
    "wavefile": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=26.7.0",
    "npm": ">=11.19.0"
  }
}
